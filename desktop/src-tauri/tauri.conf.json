{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IRIS",
  "version": "0.9.3",
  "identifier": "os.iris.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; object-src 'none'; frame-src 'none'; base-uri 'self'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../companion/src-tauri/icons/icon.ico",
      "../../companion/src-tauri/icons/icon.png"
    ]
  }
}
