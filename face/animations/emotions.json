{
    "emotions": {
        "neutral":     { "eyeScale": 1.0, "mouthOpen": 0.0, "browRaise": 0.0, "smile": 0.0 },
        "feliz":       { "eyeScale": 1.1, "mouthOpen": 0.1, "browRaise": 0.2, "smile": 0.8 },
        "triste":      { "eyeScale": 0.9, "mouthOpen": 0.0, "browRaise": -0.3, "smile": -0.5 },
        "pensativa":   { "eyeScale": 0.95, "mouthOpen": 0.0, "browRaise": 0.3, "smile": 0.0 },
        "sorprendida": { "eyeScale": 1.3, "mouthOpen": 0.5, "browRaise": 0.6, "smile": 0.0 },
        "enojada":     { "eyeScale": 0.8, "mouthOpen": 0.1, "browRaise": -0.5, "smile": -0.3 }
    },
    "animations": {
        "idle": {
            "duration": -1,
            "loop": true,
            "keyframes": {
                "breathScale": { "min": 0.995, "max": 1.005, "frequency": 1.5 },
                "headSwayY": { "min": -0.01, "max": 0.01, "frequency": 0.4 },
                "headSwayZ": { "min": -0.008, "max": 0.008, "frequency": 0.3 }
            }
        },
        "saludar_feliz": {
            "duration": 1.2,
            "loop": false,
            "keyframes": [
                { "time": 0.0, "headRotX": 0.0, "emotion": "feliz" },
                { "time": 0.2, "headRotX": -0.3 },
                { "time": 0.5, "headRotX": 0.15 },
                { "time": 1.0, "headRotX": 0.0 }
            ]
        },
        "pensar": {
            "duration": 2.0,
            "loop": false,
            "keyframes": [
                { "time": 0.0, "headRotZ": 0.0, "emotion": "pensativa" },
                { "time": 0.5, "headRotZ": 0.15 },
                { "time": 1.5, "headRotZ": 0.15 },
                { "time": 2.0, "headRotZ": 0.0 }
            ]
        },
        "asentir": {
            "duration": 0.6,
            "loop": false,
            "keyframes": [
                { "time": 0.0, "headRotX": 0.0 },
                { "time": 0.15, "headRotX": -0.2 },
                { "time": 0.35, "headRotX": 0.1 },
                { "time": 0.6, "headRotX": 0.0 }
            ]
        },
        "negar": {
            "duration": 0.6,
            "loop": false,
            "keyframes": [
                { "time": 0.0, "headRotY": 0.0 },
                { "time": 0.15, "headRotY": -0.15 },
                { "time": 0.3, "headRotY": 0.15 },
                { "time": 0.45, "headRotY": -0.08 },
                { "time": 0.6, "headRotY": 0.0 }
            ]
        }
    },
    "blinking": {
        "minInterval": 2.0,
        "maxInterval": 7.0,
        "duration": 0.12
    }
}
