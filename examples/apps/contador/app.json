{
  "schema": "iris.app-manifest/v1",
  "sdkVersion": 2,
  "id": "contador",
  "name": "Contador",
  "version": "1.0.0",
  "description": "Ejemplo comunitario con Python, widget y acciones para Iris",
  "icon": "sparkle",
  "accent": "cyan",
  "presentation": "window",
  "window": { "width": 440, "height": 380 },
  "ui": { "entry": "main.js", "style": "style.css" },
  "widgets": [{
    "id": "contador.value",
    "name": "Contador local",
    "entry": "widget.js",
    "style": "style.css",
    "size": "compact",
    "configVersion": 1,
    "preview": { "layout": "summary", "title": "Contador", "subtitle": "Un valor compartido con tu app", "items": [{ "label": "7", "detail": "Ejemplo de valor local" }] }
  }],
  "extension": {
    "schema": "iris.app-extension/v1",
    "python": "main.py",
    "skill": true,
    "operations": [
      { "action": "status", "label": "Consultar contador", "effect": "read", "arguments": {} },
      { "action": "increment", "label": "Sumar al contador", "effect": "local", "arguments": { "amount": "integer" } }
    ]
  }
}
