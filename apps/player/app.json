{
  "schema": "iris.app-manifest/v1",
  "sdkVersion": 1,
  "id": "player",
  "name": "IRIS Player",
  "version": "1.0.0",
  "description": "Música local y privada",
  "icon": "player",
  "accent": "magenta",
  "presentation": "window",
  "window": {
    "width": 1120,
    "height": 680
  },
  "launcher": {
    "visible": true,
    "order": 120
  },
  "ui": {
    "adapter": "legacy"
  },
  "widgets": [
    { "id": "player.transport", "name": "IRIS Player", "entry": "widget.js", "style": "widget.css", "size": "compact", "configVersion": 1,
      "preview": { "layout": "player", "title": "Tu música, a mano", "subtitle": "Artista y pista de ejemplo", "items": [] }
    }
  ]
}
