include companion/release-manifest.json
include dist/companion/*.exe
recursive-include .hermes/skills/iris-os *.md *.py
include .hermes/skills/iris-app-builder/SKILL.md
include .hermes/skills/iris-app-builder/template/app.json
include .hermes/skills/iris-app-builder/template/ui/main.js
include .hermes/skills/iris-app-builder/template/ui/style.css
include .hermes/skills/iris-app-builder/template/ui/widget.js
include apps/README.md
include docs/guides/community-apps-python.md
include examples/apps/contador/app.json examples/apps/contador/LICENSE
include examples/apps/contador/ui/main.js examples/apps/contador/ui/style.css
include examples/apps/contador/ui/view.js examples/apps/contador/ui/widget.js
include examples/apps/contador/backend/main.py examples/apps/contador/skill/SKILL.md

# A build may run in a developer workspace that contains ignored avatars,
# animation packs or bytecode. They must never enter a source distribution
# merely because they exist on that machine.
exclude face/animations/*.vrma
exclude face/animations/*.glb
exclude face/animations/*.gltf
exclude face/animations/*.bvh
exclude face/animations/*.fbx
global-exclude *.pyc *.pyo

# Explicit factory inventory; exclusions above still cover local packs/drafts.
include scripts/distribution_build.py
include scripts/distribution_assets.py
include scripts/distribution_web_assets.py
include scripts/release_web_assets.json
include face/web-assets.json
include scripts/verify_distribution.py
include scripts/release_assets.json
include scripts/lock_extras.py
include core/extras_data/manifest.json
include core/extras_data/pylock.*.toml
include face/animations/iris_idle.vrma
include face/animations/iris_idle_casual.vrma
include face/animations/iris_idle_lazy.vrma
