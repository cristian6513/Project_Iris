    "install_stamp": {
      "distribution": "iris",
      "update_mechanism": "external"
    },
    "source_patches": [
      {
        "id": "session-lock-resolved-provider",
        "reason": "Hermes 0.23.3: the session API route never records the provider it resolved, so a confirmed model lock on a named custom provider (a providers: entry such as LM Studio or Ollama) compares the literal name with the agent's 'custom' and discards the finished turn. This records it as api_server._create_agent does. Drop it when upstream fixes the route.",
        "files": [
          {
            "path": "gateway/session_api_turn.py",
            "sha256": "463e252579b053fb9f02bb201986d502fb9c0bf432faac609ae31852aa67d034",
            "patched_sha256": "98f90ba6ad0e5a332681470763f8b0953a21786687ebe002a4aeb71f20bf5772",
            "replace": [
              {
                "old": "        gateway_session_key=None, session_id=None)\n    return model, runtime_kwargs\n",
                "new": "        gateway_session_key=None, session_id=None)\n    # IRIS patch session-lock-resolved-provider: the provider this route resolved, for the\n    # confirmed-lock check (_create_agent records it; this route never did).\n    current['resolved_provider'] = runtime_kwargs.get('provider') or ''\n    return model, runtime_kwargs\n"
              }
            ]
          },
          {
            "path": "gateway/run_turn_runner.py",
            "sha256": "3843440af2cd02c925e6adebd093090d35dbec5df79d8bb627d4f60960da2c97",
            "patched_sha256": "0ff8f2f63ba448f973780220359b4761eda85f70df1b65f900d99d6da9c34ba7",
            "replace": [
              {
                "old": "    settings = api['settings']\n    try:\n        captured['usage']['runtime'] = api['adapter']._turn_runtime_metadata(\n",
                "new": "    settings = api['settings']\n    # IRIS patch session-lock-resolved-provider: _create_agent's runtime record, which this\n    # route never made, so a named custom provider is compared by its resolved identity.\n    if not getattr(agent, '_hermes_api_runtime', None):\n        agent._hermes_api_runtime = {\n            'provider': api.get('resolved_provider') or '', 'model': getattr(agent, 'model', '') or '',\n            'route_source': settings.get('route_source') or ''}\n    try:\n        captured['usage']['runtime'] = api['adapter']._turn_runtime_metadata(\n"
              }
            ]
          }
        ]
      }
    ]
  },
