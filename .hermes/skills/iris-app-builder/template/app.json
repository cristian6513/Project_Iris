{
  "schema": "iris.app-manifest/v1",
  "sdkVersion": 2,
  "id": "mi-app",
  "name": "Mi app",
  "description": "Plantilla local de Iris con ventana y widget",
  "version": "0.1.0",
  "icon": "sparkle",
  "accent": "cyan",
  "presentation": "window",
  "window": { "width": 520, "height": 390 },
  "ui": { "entry": "main.js", "style": "style.css" },
  "widgets": [
    {
      "id": "mi-app.resumen",
      "name": "Resumen",
      "entry": "widget.js",
      "style": "style.css",
      "size": "compact",
      "configVersion": 1,
      "preview": {
        "layout": "summary",
        "title": "Mi app",
        "subtitle": "Datos de ejemplo",
        "items": [{ "label": "Resumen", "detail": "Abre la app para ver sus datos." }]
      }
    }
  ]
}
