# IRIS OS - optional environment overrides
# Copy to .env only when you need process-level overrides. The setup wizard is
# the recommended place to configure providers, voice and appearance.
# Never commit a populated .env file.

# Hermes Agent bridge
IRIS_HERMES_URL=http://127.0.0.1:8642
# Leave empty to use the private API_SERVER_KEY in Hermes' own .env. For a
# remote HTTPS endpoint, paste a distinct remote credential explicitly.
IRIS_HERMES_API_KEY=
IRIS_HERMES_MODEL=hermes-agent

# Speech-to-text
IRIS_STT_PROVIDER=whisper-local
IRIS_WHISPER_MODEL=base
IRIS_WHISPER_API_KEY=

# Text-to-speech
IRIS_TTS_PROVIDER=edge-tts
IRIS_EDGE_TTS_VOICE=es-MX-DaliaNeural
IRIS_ELEVENLABS_API_KEY=
IRIS_ELEVENLABS_VOICE_ID=
IRIS_MINIMAX_API_KEY=
IRIS_MINIMAX_VOICE_ID=Spanish_Wiselady
IRIS_MINIMAX_TTS_MODEL=speech-2.8-hd
IRIS_FISH_AUDIO_API_KEY=
IRIS_FISH_AUDIO_VOICE_ID=
IRIS_FISH_AUDIO_MODEL=s2.1-pro-free

# Avatar
IRIS_AVATAR_TYPE=procedural
IRIS_AVATAR_VRM_PATH=

# Perception (optional; install iris-os[perception])
IRIS_PERCEPTION_ENABLED=false
IRIS_PERCEPTION_CAMERA=0
IRIS_PERCEPTION_YOLO=true
IRIS_PERCEPTION_MEDIAPIPE=true
IRIS_PERCEPTION_FPS=2.0

# Hardware (optional)
IRIS_HARDWARE_ENABLED=false
IRIS_SERIAL_PORT=
IRIS_SERIAL_BAUDRATE=9600

# Wake word is owned by Hermes Agent and is off by default. Configure
# "Hey Hermes" or the profile-name phrase from IRIS Settings; IRIS does not
# use or require a separate Porcupine key.

# Former ALICE_* names are read only for migration compatibility. New
# installations should always use the IRIS_* names above.
